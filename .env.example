# =============================================================
# EQUIP Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================

# ─── DATABASE ────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here
DB_NAME=equip_db
DATABASE_URL=postgresql://postgres:your_strong_db_password_here@db:5432/equip_db

# ─── AUTH ────────────────────────────────────────────────────────────────
JWT_SECRET=your_256bit_random_secret_here
# Generate a strong secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── EMAIL (Gmail SMTP) ───────────────────────────────────────────────
GMAIL_USER=your@gmail.com
GMAIL_PASS=your_gmail_app_password
# Use a Gmail App Password, NOT your account password.
# Generate at: https://myaccount.google.com/apppasswords

# ─── AI / EXTERNAL APIs ───────────────────────────────────────────────
GEMINI_API_KEY=
OPENWEBNINJA_API_KEY=

# ─── APP CONFIG ─────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@equipdigos.com
CORS_ORIGIN=https://equipdigos.com,https://www.equipdigos.com
VITE_API_URL=https://api.equipdigos.com
NODE_ENV=production
PORT=5000
